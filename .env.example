# Copy to .env.local and fill in. Vite exposes only VITE_* vars to the browser,
# so never put secrets here.

# Backend API. Local: `npm run dev` in Faith-Link-Backend serves it on port 8787.
VITE_API_BASE_URL=http://localhost:8787

# Neon Auth base URL (public). Same value as NEON_AUTH_BASE_URL in the backend's .env.local.
VITE_NEON_AUTH_URL=
